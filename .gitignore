# Secrets and local config
.env

# Dependencies
node_modules/
# package-lock.json is tracked on purpose: npm install needs .npmrc's
# legacy-peer-deps plus a pinned tree to resolve reproducibly.

# Local database (Phase 2). Docker-mountable; back it up with the WAL files.
data/*.db
data/*.db-wal
data/*.db-shm

# Phase 5 backups. Full copies of the database, so they carry the same
# sensitive content (loyalty balance snapshots) and must never be committed.
data/backups/

# Unattended scheduler logs. No secrets are logged, but run history belongs in
# the database, not in the repository.
data/*.log

# Generated search output and caches
results*.json
roame-results*.json
atf-results*.json
# Superseded by provider_usage in the database; kept ignored so an old copy
# left over from Phase 1 is never committed.
serpapi-usage.json
tmp/

# Python virtualenv for the helper scripts
.venv/

# Agent scratch
.hybrid-squad/
integrations/

# Scratch files written by review/verification agents while reproducing a bug.
# They are throwaway probes, not part of the project.
_repro*.ts
__refute_tmp*.ts
tests/zz-*-tmp.test.ts
_probe*.ts
.bench-tmp*.ts
_atf_*.ts
_aw*.ts
