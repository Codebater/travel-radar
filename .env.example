# Flight Search Agent — Environment Variables
# Copy this file to .env and fill in your keys. Never commit .env.
#
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# Every credential below is OPTIONAL: the app starts and the dashboard loads
# without any of them. Each missing credential disables exactly one source and
# is reported in the server console rather than crashing the search.
#
# Since Phase 2 the free cash-price provider needs no credentials at all, so a
# clean checkout returns real prices with an empty .env.

# ═══ Credentials ════════════════════════════════════════════════════════════

# ─── SerpAPI — metered cash-price VERIFICATION ──────────────────────────────
# Since Phase 2 SerpAPI is no longer the default cash source. It is called to
# confirm a price the free provider found, when a search asks for verification,
# when the user hits "Refresh live price", or when the free provider fails.
# Free tier: 100 searches/month. Budget and reserve are configured below.
# Get a key: https://serpapi.com/manage-api-key
SERP_API_KEY=

# ─── Award Travel Finder (ATF) — award cross-reference ──────────────────────
# Covers BA Avios, Qatar Privilege Club, Asia Miles, Virgin Points, Iberia Plus.
# Budget: 150 calls/month; one full search costs 5 calls (one per airline).
# Only used when "atf" is included in --sources.
# Alternative: ~/.openclaw/credentials/awardtravelfinder.json
#   { "apiKey": "your-key-here" }
ATF_API_KEY=

# ═══ Database ═══════════════════════════════════════════════════════════════

# SQLite file holding the cache, price history and provider accounting.
# Relative paths resolve against the project root. Mount this path as a Docker
# volume later so the history survives container rebuilds.
DATABASE_PATH=./data/travel-radar.db

# ═══ Cache ══════════════════════════════════════════════════════════════════
#
# CACHE answers "what did we recently fetch?" and expires.
# HISTORY answers "what prices have we observed over time?" and never expires.
# Clearing the cache never touches the history.

# How long a cash-fare result stays servable without refetching.
CASH_CACHE_TTL_HOURS=8

# Award availability moves faster than cash pricing, so it expires sooner.
AWARD_CACHE_TTL_HOURS=2

# ═══ Provider budgets ═══════════════════════════════════════════════════════

# Total metered SerpAPI calls allowed per calendar month.
SERPAPI_MONTHLY_BUDGET=90

# Of that budget, how many calls are held back for explicit user-initiated
# verification. Automated code may spend up to (BUDGET - RESERVE) and refuses to
# go further, answering "SerpAPI automation budget exhausted; cached/free-
# provider results shown". Only a manual "Refresh live price" may use these.
SERPAPI_RESERVE_CALLS=10

# ═══ Search behaviour ═══════════════════════════════════════════════════════

# Currency requested from cash providers. The value engine compares cash prices
# against award taxes without FX conversion, so changing this away from USD will
# make CPP figures meaningless until a conversion layer exists.
CASH_CURRENCY=USD

# ═══ Credentials NOT read from .env ═════════════════════════════════════════
# Two providers read JSON credential files from the home directory instead.
# Listed here so the full set of secrets is documented in one place.
#
# Roame (award availability across 19+ programs) — required for the "roame" source
#   ~/.openclaw/credentials/roame.json
#   { "session": "<firebase session jwt>", "csrfSecret": "<csrf secret>",
#     "sessionExpiresAt": 1771829264892 }
#   Obtained by logging in at roame.travel and copying the session cookies.
#   Sessions expire; the scraper fails fast with the expiry date when they do.
#
# AwardWallet (real loyalty balances) — optional
#   ~/.openclaw/credentials/awardwallet.json
#   { "apiKey": "your-api-key", "userId": "your-user-id" }
#   Without it the app falls back to a hardcoded balance list in search.ts.
