# Flight Search Agent — Environment Variables
# Copy this file to .env and fill in your keys. Never commit .env.
#
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# Every credential below is OPTIONAL: the app starts and the dashboard loads
# without any of them. Each missing credential disables exactly one source and
# is reported in the server console rather than crashing the search.
#
# Since Phase 2 the free cash-price provider needs no credentials at all, so a
# clean checkout returns real prices with an empty .env.

# ═══ Credentials ════════════════════════════════════════════════════════════

# ─── SerpAPI — metered cash-price VERIFICATION ──────────────────────────────
# Since Phase 2 SerpAPI is no longer the default cash source. It is called to
# confirm a price the free provider found, when a search asks for verification,
# when the user hits "Refresh live price", or when the free provider fails.
# Free tier: 100 searches/month. Budget and reserve are configured below.
# Get a key: https://serpapi.com/manage-api-key
SERP_API_KEY=

# ─── Award Travel Finder (ATF) — award cross-reference ──────────────────────
# Covers BA Avios, Qatar Privilege Club, Asia Miles, Virgin Points, Iberia Plus.
# Budget: 150 calls/month; one full search costs 5 calls (one per airline).
# Only used when "atf" is included in --sources.
# Alternative: ~/.openclaw/credentials/awardtravelfinder.json
#   { "apiKey": "your-key-here" }
ATF_API_KEY=

# ═══ Database ═══════════════════════════════════════════════════════════════

# SQLite file holding the cache, price history and provider accounting.
# Relative paths resolve against the project root. Mount this path as a Docker
# volume later so the history survives container rebuilds.
DATABASE_PATH=./data/travel-radar.db

# ═══ Cache ══════════════════════════════════════════════════════════════════
#
# CACHE answers "what did we recently fetch?" and expires.
# HISTORY answers "what prices have we observed over time?" and never expires.
# Clearing the cache never touches the history.

# How long a cash-fare result stays servable without refetching.
CASH_CACHE_TTL_HOURS=8

# Award availability moves faster than cash pricing, so it expires sooner.
# Phase 3 wires this into the award providers: within TTL a repeated identical
# award search re-queries neither Roame nor ATF and spends no quota.
AWARD_CACHE_TTL_HOURS=2

# How long a loyalty-balance snapshot stays fresh. Balances change when you
# earn or burn, not minute by minute; searches use the snapshot, and only an
# explicit refresh refetches early.
LOYALTY_BALANCE_TTL_HOURS=12

# ═══ Provider budgets ═══════════════════════════════════════════════════════

# Total metered SerpAPI calls allowed per calendar month.
SERPAPI_MONTHLY_BUDGET=90

# Of that budget, how many calls are held back for explicit user-initiated
# verification. Automated code may spend up to (BUDGET - RESERVE) and refuses to
# go further, answering "SerpAPI automation budget exhausted; cached/free-
# provider results shown". Only a manual "Refresh live price" may use these.
SERPAPI_RESERVE_CALLS=10

# ═══ Award providers ════════════════════════════════════════════════════════

# ATF costs ONE call per airline per search and the free tier is economy-only
# with only a few calls per day, so keep this list narrow. Unset = all five
# (british_airways, qatar_airways, cathay_pacific, virgin_atlantic, iberia),
# which will exhaust a free daily allowance in a single search.
ATF_AIRLINES=iberia

# Monthly allowance assumed before ATF reports its own number. The vendor
# states the free tier five different ways (3/day, 5/day, 50/month); this is
# the most conservative published figure and is always overridden by whatever
# ATF actually reports in a response.
ATF_MONTHLY_LIMIT=50

# Each award source can be disabled independently without touching the others.
# Disabled is different from unconfigured: disabled providers are skipped
# silently, unconfigured ones surface a "not configured" warning.
ENABLE_ROAME=true
ENABLE_ATF=true
ENABLE_AWARDWALLET=true

# ═══ Observer (scheduled baseline collection) ═══════════════════════════════

# Seconds between scheduler ticks, and how long a scheduler lease survives
# without a heartbeat before another instance may take over.
OBSERVER_TICK_SECONDS=60
OBSERVER_LEASE_TTL_SECONDS=90

# ═══ Backups (Phase 5) ══════════════════════════════════════════════════════

# The observation history is the one thing here that cannot be re-fetched, so
# whoever holds the scheduler lease takes an online SQLite snapshot on this
# interval and keeps the newest BACKUP_RETENTION copies. Backups are full
# copies of the database and therefore carry loyalty balance snapshots: they
# are git-ignored and must stay that way.
BACKUP_DIR=data/backups
BACKUP_RETENTION=14
BACKUP_INTERVAL_HOURS=24

# ═══ Discovery engine (Phase 6) ═════════════════════════════════════════════

# Nothing to set here either. Where the engine looks (home region, positioning
# airports, destination groups, wildcards), how widely it samples, and what a
# cycle may spend all live in config/discovery.json - so widening the search is
# an edit to a data file, and the exact scope that produced a run is recorded
# rather than implied.
#
# The one thing worth knowing: stage 1 and stage 2 can never spend a metered
# call, and the SerpAPI manual reserve is unreachable from any automated path
# because the discovery pool is computed from the ceiling that already has the
# reserve subtracted. `npm run discovery:pool` prints all four numbers.

# ═══ Shadow anomaly engine (Phase 5) ════════════════════════════════════════

# There is nothing to configure here on purpose: every weight, threshold,
# confidence tier and extreme-deal preset lives in config/anomaly.json so the
# intelligence can be tuned without touching code, and so the exact
# configuration that produced a decision is recorded on the decision itself.
#
# The engine runs in SHADOW MODE: it stores what it thinks and sends nothing.
# There is no notification transport in the codebase, and no environment
# variable can create one.

# ═══ Search behaviour ═══════════════════════════════════════════════════════

# Hidden-city: how many beyond-city searches per hidden-city sweep (each is an
# ordinary cash search — cached, budget-guarded, mostly free via fast_flights).
HIDDEN_CITY_MAX_BEYOND=5

# Currency requested from cash providers. The value engine compares cash prices
# against award taxes without FX conversion, so changing this away from USD will
# make CPP figures meaningless until a conversion layer exists.
CASH_CURRENCY=USD

# ═══ Credentials NOT read from .env ═════════════════════════════════════════
# Two providers read JSON credential files from the home directory instead.
# Listed here so the full set of secrets is documented in one place.
#
# Roame (award availability across 19+ programs) — required for the "roame" source
#   ~/.openclaw/credentials/roame.json
#   { "session": "<firebase session jwt>", "csrfSecret": "<csrf secret>",
#     "sessionExpiresAt": 1771829264892 }
#   Obtained by logging in at roame.travel and copying the session cookies.
#   Sessions expire; the scraper fails fast with the expiry date when they do.
#
# AwardWallet (real loyalty balances) — optional
#   ~/.openclaw/credentials/awardwallet.json
#   { "apiKey": "your-api-key", "userId": "your-user-id" }
#   userId is discovered automatically and cached back into the file when the
#   plan exposes /connections. Without working credentials the app falls back
#   to a hardcoded balance list and says so.
#
# Award Travel Finder (ATF) — optional, issued by an operator command
#   ~/.openclaw/credentials/awardtravelfinder.json
#   { "apiKey": "..." }
#   Created by `npm run atf:register`, which POSTs to the vendor's
#   autonomous-agent endpoint and stores the key it hands back. The key is
#   never printed beyond a fingerprint. The MCP endpoint cannot be used
#   unattended: its OAuth 2.1 server offers no client_credentials grant.
