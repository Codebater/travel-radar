# Travel Radar — production environment (.env, next to compose.yaml).
#
# THIS FILE IS THE ONLY PLACE SECRETS LIVE. Never a config file, never the
# image, never git. On the NAS: chmod 600 .env.
#
# Everything a value below feeds into refuses to print it back: the channel
# reports "topic hidden", redactSecrets scrubs error strings, and the security
# suite boots the server with canary values and asserts no page or API serves
# them.

# ── Notification destination (self-hosted ntfy) ──────────────────────────────
# The topic is the address of your phone. On any ntfy server a guessable topic
# is an open mailbox, so use a long random one:  openssl rand -hex 12
NTFY_TOPIC=
# Access token for the write-only publishing user. Full provisioning sequence
# (deny-all means every step below is required, in order):
#   docker exec -e NTFY_PASSWORD=<pw>  ntfy ntfy user add radar
#   docker exec ntfy ntfy access radar <topic> write-only
#   docker exec ntfy ntfy token add radar        -> this value
#   docker exec -e NTFY_PASSWORD=<pw2> ntfy ntfy user add <phone-user>
#   docker exec ntfy ntfy access <phone-user> <topic> read-only
NTFY_TOKEN=
# NTFY_SERVER and NTFY_ALLOW_HTTP_HOST are set in compose.yaml (the radar
# publishes to the ntfy container over the internal network). Do not set them
# here unless you are deliberately pointing at a different server.

# ── Provider keys (copy the values from the Windows .env) ────────────────────
# SerpAPI — metered Google Flights verification. The monthly budget and the
# untouchable manual reserve are enforced in the database, not here.
SERP_API_KEY=
# Award Travel Finder — optional; empty means the provider reports unconfigured.
ATF_API_KEY=

# ── Optional overrides (defaults are correct for this deployment) ────────────
# CASH_CURRENCY=USD
# OBSERVER_TICK_SECONDS=60
# OBSERVER_LEASE_TTL_SECONDS=90
# NOTIFICATIONS_ENABLED=false     # emergency kill switch; the real on/off is
#                                 # config/notifications.json "enabled"
