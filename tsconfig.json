{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ]
  },
  "//": "Scoped to the live search path (search.ts / serve.ts and the modules they reach).",
  "include": [
    "search.ts",
    "serve.ts",
    "roame-scraper.ts",
    "atf-scraper.ts",
    "value-engine.ts",
    "sweet-spots.ts",
    "transfer-partners.ts",
    "db/**/*.ts",
    "cache/**/*.ts",
    "providers/**/*.ts",
    "tests/**/*.ts"
  ]
}
