# vite-plugin-watch-and-run@1.8.x declares a peer dependency on vite >= 5, while
# this project pins vite ^4.3.9 for the awardwiz scraper tooling. npm 7+ treats
# that as a hard ERESOLVE failure, so peer resolution is relaxed here rather than
# bumping either package. Remove once the vite 4 pin is revisited.
legacy-peer-deps=true
